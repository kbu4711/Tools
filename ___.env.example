# Copy this file to .env and fill in your own values.
# Do not commit the real .env file.

# GitHub Models / Copilot-compatible token with models:read permission
GITHUB_MODELS_TOKEN=your_github_models_token_here

# Optional alternative variable names recognized by the pipeline
# GITHUB_TOKEN=your_github_models_token_here
# GH_TOKEN=your_github_models_token_here

# Optional default model for GitHub Models inference
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Optional organization for attributed GitHub Models usage
# GITHUB_MODELS_ORG=your-github-org
